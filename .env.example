# ---- 必填 ----
DASHSCOPE_API_KEY=

# ---- 模型 ----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# ---- 基础设施 ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# ---- 应用 ----
# 相对仓库根目录
DB_PATH=data/app.db
DATA_DIR=data
# 项目源码扫描白名单，Windows 用分号分隔
PROJECT_ROOTS=D:\
# 前端开发服务器地址（CORS）
DEV_ORIGIN=http://localhost:5173

# ---- 对话助手 ----
# 对话工具回调自身 REST API 的地址（改端口时同步改这里）
API_BASE=http://127.0.0.1:8000
# 模型上下文窗口（未知时先按 32k 估算，长会话后按压缩事件校准）
CHAT_CONTEXT_WINDOW=32768
# 占用超过窗口 60% 触发自动压缩；超过 70% 且压缩无效则硬截断
CHAT_COMPACT_RATIO=0.6
CHAT_BUDGET_RATIO=0.7
# 压缩时保留最近几轮工具结果全文
CHAT_KEEP_RECENT_TURNS=2
# 单轮工具结果回灌上限（字符）
CHAT_TOOL_RESULT_LIMIT=6000
